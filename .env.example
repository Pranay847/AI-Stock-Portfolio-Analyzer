OPENAI_API_KEY=your_openai_api_key_here
# Optional: set other provider keys if using different embedding/model providers
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Secure brokerage connection via SnapTrade (https://snaptrade.com)
# Lets users connect Robinhood without this app ever seeing their password.
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key
# 'commercial' lets any visitor connect their own account (paid tier).
# 'personal' is the free key and works only for your own accounts.
SNAPTRADE_AUTH_MODE=commercial

# Set to false locally to enable the direct Robinhood login form instead
DEMO_MODE=true
