# Market data (required) -- free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
# Optional: alternate spelling accepted by some scripts
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Secure brokerage connection via SnapTrade (https://snaptrade.com)
# Lets users connect Robinhood without this app ever seeing their password.
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key
# 'personal' = free key, your own accounts only (default).
# 'commercial' = paid tier, lets any visitor connect their own account.
SNAPTRADE_AUTH_MODE=personal

# Set to false locally to enable the direct Robinhood login form instead
DEMO_MODE=true

# LLM reasoning backend.
# Set one of these to use a hosted provider, which is required for any
# deployment that cannot run a local Ollama server (e.g. Streamlit Cloud).
# If neither is set, reasoning falls back to local Ollama, then to the model
# signal alone. MISTRAL_API_KEY takes precedence over OPENAI_API_KEY.
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides. The Mistral default (ministral-3b-latest) is one of
# the models the free tier actually serves -- mistral-small-latest and larger
# return 429 with zero quota there. Set this if your workspace has access to
# the bigger models.
# MISTRAL_MODEL=mistral-small-latest
# OPENAI_MODEL=gpt-4o-mini

# Optional: only needed for the legacy direct Robinhood login path
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
