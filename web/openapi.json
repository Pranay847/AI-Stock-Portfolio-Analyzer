{
  "components": {
    "schemas": {
      "AnalysisJobState": {
        "properties": {
          "completed": {
            "default": 0,
            "title": "Completed",
            "type": "integer"
          },
          "current_symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Symbol"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "notes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "results": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PositionAnalysis"
            },
            "title": "Results",
            "type": "array"
          },
          "status": {
            "enum": [
              "idle",
              "queued",
              "running",
              "done",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "total": {
            "default": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "status"
        ],
        "title": "AnalysisJobState",
        "type": "object"
      },
      "AnalyzeStockRequest": {
        "properties": {
          "query": {
            "description": "Ticker or company name",
            "maxLength": 64,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "AnalyzeStockRequest",
        "type": "object"
      },
      "Capabilities": {
        "properties": {
          "ai_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Active LLM backend, or null for rule-based only",
            "title": "Ai Backend"
          },
          "market_data": {
            "description": "A quote provider is configured",
            "title": "Market Data",
            "type": "boolean"
          },
          "snaptrade": {
            "anyOf": [
              {
                "enum": [
                  "personal",
                  "commercial"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "SnapTrade key type, or null if brokerage connection is not configured",
            "title": "Snaptrade"
          }
        },
        "required": [
          "market_data",
          "ai_backend",
          "snaptrade"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "ConnectResponse": {
        "properties": {
          "portal_url": {
            "title": "Portal Url",
            "type": "string"
          }
        },
        "required": [
          "portal_url"
        ],
        "title": "ConnectResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "Liveness only, so container health checks never wait on analyzer start-up.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "OwnerUnlockRequest": {
        "properties": {
          "token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "OwnerUnlockRequest",
        "type": "object"
      },
      "PortfolioState": {
        "properties": {
          "positions": {
            "items": {
              "$ref": "#/components/schemas/Position"
            },
            "title": "Positions",
            "type": "array"
          },
          "snaptrade": {
            "$ref": "#/components/schemas/SnapTradeState"
          },
          "source": {
            "anyOf": [
              {
                "enum": [
                  "demo",
                  "snaptrade"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PortfolioSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "positions",
          "summary",
          "snaptrade"
        ],
        "title": "PortfolioState",
        "type": "object"
      },
      "PortfolioSummary": {
        "properties": {
          "best_performer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Best Performer"
          },
          "losers": {
            "title": "Losers",
            "type": "integer"
          },
          "total_cost_basis": {
            "title": "Total Cost Basis",
            "type": "number"
          },
          "total_equity": {
            "title": "Total Equity",
            "type": "number"
          },
          "total_positions": {
            "title": "Total Positions",
            "type": "integer"
          },
          "total_profit_loss": {
            "title": "Total Profit Loss",
            "type": "number"
          },
          "total_profit_loss_percent": {
            "title": "Total Profit Loss Percent",
            "type": "number"
          },
          "winners": {
            "title": "Winners",
            "type": "integer"
          },
          "worst_performer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worst Performer"
          }
        },
        "required": [
          "total_positions",
          "total_equity",
          "total_cost_basis",
          "total_profit_loss",
          "total_profit_loss_percent",
          "winners",
          "losers",
          "best_performer",
          "worst_performer"
        ],
        "title": "PortfolioSummary",
        "type": "object"
      },
      "Position": {
        "properties": {
          "average_buy_price": {
            "title": "Average Buy Price",
            "type": "number"
          },
          "cost_basis": {
            "title": "Cost Basis",
            "type": "number"
          },
          "current_price": {
            "title": "Current Price",
            "type": "number"
          },
          "equity": {
            "title": "Equity",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "profit_loss": {
            "title": "Profit Loss",
            "type": "number"
          },
          "profit_loss_percent": {
            "title": "Profit Loss Percent",
            "type": "number"
          },
          "quantity": {
            "title": "Quantity",
            "type": "number"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "name",
          "quantity",
          "average_buy_price",
          "current_price",
          "equity",
          "cost_basis",
          "profit_loss",
          "profit_loss_percent"
        ],
        "title": "Position",
        "type": "object"
      },
      "PositionAnalysis": {
        "properties": {
          "analysis_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Type"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "current_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Price"
          },
          "profit_loss_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profit Loss Percent"
          },
          "reasons": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "recommendation": {
            "title": "Recommendation",
            "type": "string"
          },
          "risks": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Risks",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "recommendation",
          "confidence",
          "summary"
        ],
        "title": "PositionAnalysis",
        "type": "object"
      },
      "SnapTradeState": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "connection_pending": {
            "title": "Connection Pending",
            "type": "boolean"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "personal",
                  "commercial"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "owner_unlock_required": {
            "title": "Owner Unlock Required",
            "type": "boolean"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          }
        },
        "required": [
          "configured",
          "mode",
          "available",
          "owner_unlock_required",
          "unavailable_reason",
          "connection_pending"
        ],
        "title": "SnapTradeState",
        "type": "object"
      },
      "StockAnalysis": {
        "properties": {
          "ai_model": {
            "title": "Ai Model",
            "type": "string"
          },
          "analysis_type": {
            "title": "Analysis Type",
            "type": "string"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "buy_price": {
            "title": "Buy Price",
            "type": "number"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "current_price": {
            "title": "Current Price",
            "type": "number"
          },
          "holding_period": {
            "title": "Holding Period",
            "type": "string"
          },
          "market_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market State"
          },
          "ok": {
            "description": "False when no analysis could be produced; see summary/reasons",
            "title": "Ok",
            "type": "boolean"
          },
          "quote_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote Source"
          },
          "reasons": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "recommendation": {
            "title": "Recommendation",
            "type": "string"
          },
          "risks": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Risks",
            "type": "array"
          },
          "sell_price": {
            "title": "Sell Price",
            "type": "number"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "xgboost_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Xgboost Confidence"
          },
          "xgboost_signal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Xgboost Signal"
          }
        },
        "required": [
          "ok",
          "symbol",
          "current_price",
          "buy_price",
          "sell_price",
          "recommendation",
          "confidence",
          "holding_period",
          "summary",
          "analysis_type",
          "ai_model"
        ],
        "title": "StockAnalysis",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AI Stock Analyzer API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/capabilities": {
      "get": {
        "operationId": "capabilities_api_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/owner/unlock": {
      "post": {
        "description": "Prove this session is the owner, so it may use a personal SnapTrade key.\n\nReturns None rather than a Response: FastAPI drops headers set on the\ninjected response when a route returns its own Response object, which would\nlose the Set-Cookie for a brand-new session -- the unlock would report\nsuccess and then vanish on the next request.",
        "operationId": "owner_unlock_api_owner_unlock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerUnlockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Owner Unlock"
      }
    },
    "/api/portfolio": {
      "delete": {
        "operationId": "disconnect_api_portfolio_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Disconnect"
      },
      "get": {
        "operationId": "get_portfolio_api_portfolio_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Portfolio"
      }
    },
    "/api/portfolio/analysis": {
      "get": {
        "operationId": "get_analysis_api_portfolio_analysis_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJobState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Analysis"
      },
      "post": {
        "operationId": "start_analysis_api_portfolio_analysis_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJobState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Start Analysis"
      }
    },
    "/api/portfolio/analysis/report": {
      "get": {
        "operationId": "analysis_report_api_portfolio_analysis_report_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Analysis Report"
      }
    },
    "/api/portfolio/demo": {
      "post": {
        "operationId": "load_demo_api_portfolio_demo_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Load Demo"
      }
    },
    "/api/snaptrade/connect": {
      "post": {
        "operationId": "snaptrade_connect_api_snaptrade_connect_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Snaptrade Connect"
      }
    },
    "/api/snaptrade/sync": {
      "post": {
        "operationId": "snaptrade_sync_api_snaptrade_sync_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Snaptrade Sync"
      }
    },
    "/api/stocks/analyze": {
      "post": {
        "operationId": "analyze_stock_route_api_stocks_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeStockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockAnalysis"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze Stock Route"
      }
    }
  }
}
